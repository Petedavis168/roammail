# ===== Where people open the web app (needs a DNS A record pointing at this server) =====
APP_DOMAIN=webmail.yourdomain.com

# ===== Your mailcow server =====
IMAP_HOST=mail.yourdomain.com
IMAP_PORT=993
IMAP_SECURE=true
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
# Public hostname customers point their MX records at (normally the same as IMAP_HOST)
MAIL_HOSTNAME=mail.yourdomain.com

# mailcow admin UI -> System -> Configuration -> Access -> API
# Create a READ-WRITE key and add this app server's public IP to "Allow API access from these IPs".
MAILCOW_API_URL=https://mail.yourdomain.com
MAILCOW_API_KEY=

# Public address of this app (used in password-reset links and hosted signature logos)
PUBLIC_URL=https://webmail.yourdomain.com
APP_NAME=Mail

# ===== Security =====
# Long random string. Generate one with:  openssl rand -hex 32
SESSION_SECRET=
COOKIE_SECURE=true
SESSION_HOURS=168
# Sign out after this many hours without activity
SESSION_IDLE_HOURS=72
# When rotating SESSION_SECRET, put the old value here so 2-step verification keeps working
SESSION_SECRET_PREVIOUS=
# Admins must turn on 2-step verification before using the admin portal
REQUIRE_ADMIN_2FA=true
# Reverse proxies in front of the app (Caddy = 1). Wrong values let clients fake their IP address.
TRUST_PROXY=1
# Check new passwords against known data breaches (Have I Been Pwned range API)
CHECK_BREACHED_PASSWORDS=true

# ===== Free sign-ups =====
SIGNUP_ENABLED=true
# Free accounts get name@SIGNUP_DOMAIN. Create this domain in mailcow first.
SIGNUP_DOMAIN=yourdomain.com
SIGNUP_QUOTA_MB=2048
SIGNUP_PER_IP_PER_DAY=3
# Max outgoing messages per free account (protects your server's reputation). Format N/s|m|h|d
SIGNUP_SEND_LIMIT=100/h
# Optional but strongly recommended: Cloudflare Turnstile captcha (free) - https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Password reset emails are sent from this mailbox. Create it in mailcow (e.g. no-reply@yourdomain.com).
# Leave empty to disable self-service password reset (admins can still reset passwords).
SYSTEM_MAIL_USER=
SYSTEM_MAIL_PASS=
SYSTEM_MAIL_FROM=

# ===== Abuse limits for webmail sending =====
FREE_SENDS_PER_DAY=150
NEW_ACCOUNT_SENDS_PER_DAY=25
BUSINESS_SENDS_PER_DAY=2000
FREE_MAX_RECIPIENTS=20
BUSINESS_MAX_RECIPIENTS=100
SIGNUPS_PER_HOUR=60

# ===== Legal & contacts (shown in /legal pages and /.well-known/security.txt) =====
LEGAL_COMPANY_NAME=
LEGAL_COUNTRY=the United States
LEGAL_CONTACT_EMAIL=
ABUSE_EMAIL=
SECURITY_CONTACT_EMAIL=
TERMS_VERSION=2026-11-07
LOG_RETENTION_DAYS=180

# ===== Business plans (defaults for each new business) =====
ORG_MAX_MAILBOXES=50
ORG_DEFAULT_QUOTA_MB=5120
ORG_MAX_QUOTA_MB=20480
ORG_TOTAL_QUOTA_MB=102400

# ===== You =====
# Comma separated. These accounts get the super-admin Platform portal.
SUPERADMIN_EMAILS=you@yourdomain.com

# ===== Phone setup =====
# iPhone/Mac profiles also add calendar & contacts from mailcow (SOGo). Set false if you disabled SOGo.
DAV_ENABLED=true
# Optional: sign the iPhone profile so iOS shows "Verified" instead of "Not Verified".
# Same server as mailcow? Use its certificate: /opt/mailcow-dockerized/data/assets/ssl/cert.pem and key.pem
PROFILE_SIGN_CERT=
PROFILE_SIGN_KEY=
PROFILE_SIGN_CHAIN=

# ===== AWS (optional): one-click DNS for domains hosted in your Route 53 =====
# Give the EC2 instance an IAM role using deploy/aws/route53-policy.json
ROUTE53_ENABLED=false
AWS_REGION=us-east-1
