# ============================================================================
#  Copy to config.env, fill in, then run:  ./deploy/aws/deploy.sh
#  (Run it in AWS CloudShell: the ">_" icon at the top of the AWS console.)
# ============================================================================

# ---- AWS ----
STACK_NAME=mail-client
# Region to run in (CloudShell's region is used if empty)
AWS_REGION=
INSTANCE_TYPE=t3.small
# Optional: Route 53 hosted zone ID of APP_DOMAIN's parent domain (e.g. Z0123456789ABC). If set, DNS is automatic.
HOSTED_ZONE_ID=
# Optional: get an email if the server has problems
ALERT_EMAIL=
# Optional: text-message alerts too, international format (e.g. +15551234567)
ALERT_PHONE=
# true = the app can add DNS records for customer domains hosted in this AWS account's Route 53
ROUTE53_ENABLED=false

# ---- Where people open the app ----
APP_DOMAIN=webmail.yourdomain.com
APP_NAME=Roammail

# ---- Your mailcow server ----
MAIL_HOSTNAME=mail.yourdomain.com
IMAP_HOST=mail.yourdomain.com
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
# mailcow UI -> System -> Configuration -> Access -> API: READ-WRITE key
MAILCOW_API_KEY=

# ---- Free sign-ups ----
SIGNUP_ENABLED=true
SIGNUP_DOMAIN=roammail.net
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---- You (super-admin) ----
SUPERADMIN_EMAILS=you@yourdomain.com

# ---- Password-reset emails (optional: a no-reply mailbox you create in mailcow) ----
SYSTEM_MAIL_USER=
SYSTEM_MAIL_PASS=

# ---- Billing (Stripe): see .env.example for all options ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ---- Legal & contacts (create these mailboxes!) ----
LEGAL_COMPANY_NAME=Friendly Web Services
LEGAL_CONTACT_EMAIL=
ABUSE_EMAIL=
SECURITY_CONTACT_EMAIL=

# Anything else from .env.example can be added here too; it is passed to the app as-is.
