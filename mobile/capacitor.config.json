{
  "appId": "net.roammail.app",
  "appName": "Roammail",
  "webDir": "www",
  "server": {
    "url": "https://roammail.net/app",
    "hostname": "roammail.net",
    "androidScheme": "https",
    "allowNavigation": [
      "roammail.net",
      "login.roammail.net",
      "app.roammail.net",
      "www.roammail.net"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": true,
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#173D56",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#173D56"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
